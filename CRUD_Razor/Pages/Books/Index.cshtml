@page
@model CRUD_Razor.IndexModel
@{


<h2>Books Management</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Book</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Author</th>
            <th>Publisher</th>
            <th>Status</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var book in Model.Books)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.title</td>
                <td>@book.author</td>
                <td>@book.publisher</td>
                <td>@book.status</td>
                <td>@book.category</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@book.Id"
                       class="btn btn-warning btn-sm">Edit</a>

                    <a asp-page="Delete" asp-route-id="@book.Id"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>}